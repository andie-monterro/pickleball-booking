{
  "name": "pickleball-booking",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "dev:otp": "OTP_DEBUG=yes OTP_CONSOLE_SECRET=local-manual-testing next dev",
    "build": "next build",
    "vercel-build": "npm run migrate:up && next build",
    "start": "next start",
    "migrate:up": "node-pg-migrate up",
    "migrate:create": "node-pg-migrate create",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "linear": "node --env-file-if-exists=.sandcastle/.env scripts/linear.mjs",
    "sandcastle": "npx tsx .sandcastle/main.ts",
    "sandcastle:verify": "npx tsx .sandcastle/verify.ts"
  },
  "dependencies": {
    "next": "^16.3.1",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@ai-hero/sandcastle": "^0.12.0",
    "@testcontainers/postgresql": "^12.1.0",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "node-pg-migrate": "^9.0.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "zod": "^4.4.3"
  }
}
