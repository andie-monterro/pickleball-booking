# Claude Code OAuth token — get one by running `claude setup-token` on your host.
# Lets the agents use your Claude subscription instead of an API key.
CLAUDE_CODE_OAUTH_TOKEN=
# Or use an Anthropic API key instead — uncomment and fill in:
# ANTHROPIC_API_KEY=

# GitHub token — the PR phase uses it to push branches and open pull requests.
# Create a fine-grained token scoped to this repository only:
# https://github.com/settings/personal-access-tokens/new
# Required repository permissions: Contents (Read and write),
# Pull requests (Read and write), Metadata (Read).
GH_TOKEN=

# Linear personal API key — the agents read and comment on tickets with it
# through scripts/linear.mjs. Create one in Linear under
# Settings → Security & access → Personal API keys.
LINEAR_API_KEY=
