# Postgres connection string. Production points at Neon; tests provision their
# own throwaway container and ignore this value.
DATABASE_URL=

# API key used by the production phone verification adapter.
PRELUDE_API_KEY=

# Temporary manual testing. `npm run dev:otp` prints each OTP in the server terminal.
# Set this explicitly in production only when OTPs may be written to restricted logs.
OTP_DEBUG=no
OTP_CONSOLE_SECRET=
